@page
@model WebClinicSystem.Web.Pages.Pacientes.IndexModel
@{
    ViewData["Title"] = "Gerenciamento de Pacientes";
}

<header class="pb-3 mb-4 border-bottom d-flex justify-content-between align-items-center">
    <h1>Gerenciamento de Pacientes</h1>

    <a asp-page="/Pacientes/Create" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill me-2"></i>Adicionar Novo Paciente
    </a>
</header>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Nome Completo</th>
                        <th>CPF</th>
                        <th>Telefone</th>
                        <th class="text-center" style="width: 120px;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var paciente in Model.Pacientes)
                    {
                        <tr>
                            <td>@paciente.NomeCompleto</td>
                            <td>@paciente.Cpf</td>
                            <td>@paciente.TelefoneContato</td>
                            <td class="text-center">

                                <a asp-page="/Pacientes/Edit" asp-route-id="@paciente.PacienteId" class="btn btn-sm btn-outline-secondary me-1" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <form method="post" asp-page-handler="Delete" asp-route-id="@paciente.PacienteId" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja excluir este paciente?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
}