@* 1. ADICIONE ESTE 'USING' NO TOPO DO SEU ARQUIVO *@
@using System.Security.Claims

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebClinicSystem</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-logo">
                <i class="fa-solid fa-heart-pulse"></i>
            </div>
            <div>
                <h5>WebClinic</h5>
                <span>System</span>
            </div>
        </div>

        @* 2. ESTA É A SEÇÃO DE MENU ATUALIZADA *@
        <ul class="nav flex-column sidebar-nav">

            @* 'Dashboard' (Home/Dashboard): Deve aparecer para todos os usuários logados. *@
            @if (User.Identity.IsAuthenticated)
            {
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Home/Dashboard">
                        <i class="fa-solid fa-house"></i>
                        Dashboard
                    </a>
                </li>
            }

            @* 'Pacientes' e 'Agenda': Devem aparecer para 'Administrador' OU 'Recepcionista'. *@
            @if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista"))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Agenda/Index">
                        <i class="fa-solid fa-calendar-days"></i>
                        Agenda
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Pacientes/Index">
                        <i class="fa-solid fa-users"></i>
                        Pacientes
                    </a>
                </li>
            }

            @* 'Prontuários': Deve aparecer para 'Administrador' OU 'Profissional de Saúde'. *@
            @if (User.IsInRole("Administrador") || User.IsInRole("Profissional de Saúde"))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Prontuario/Index">
                        <i class="fa-solid fa-file-medical"></i>
                        Prontuários
                    </a>
                </li>
            }

            @* 'Profissionais', 'Usuários' e 'Relatórios': Devem aparecer APENAS para 'Administrador'. *@
            @if (User.IsInRole("Administrador"))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Profissionais/Index">
                        <i class="fa-solid fa-user-doctor"></i>
                        Profissionais
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Usuarios/Index">
                        <i class="fa-solid fa-users-cog"></i>
                        Usuários
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Relatorio/Index">
                        <i class="fa-solid fa-chart-line"></i>
                        Relatórios
                    </a>
                </li>
            }

            @* 'Meu Perfil': Deve aparecer para todos os usuários logados. *@
            @if (User.Identity.IsAuthenticated)
            {
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Perfil/Index">
                        <i class="fa-solid fa-user"></i>
                        Meu Perfil
                    </a>
                </li>
            }
        </ul>


        @* 3. ESTA É A SEÇÃO DE LOGOUT ATUALIZADA *@
        <div class="sidebar-footer">
            @if (User.Identity.IsAuthenticated)
            {
                @* O Logout deve ser um formulário POST, não um link <a>.
                   Usamos classes do Bootstrap para que o botão pareça um link.
                *@
                <form asp-page="/Login/Index" asp-page-handler="Logout" method="post" class="nav-item w-100">
                    <button type="submit" class="nav-link btn btn-link text-white w-100 text-start">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Logout
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="main-content">
        <main role="main" class="container-fluid py-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>