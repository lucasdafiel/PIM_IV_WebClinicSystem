@page
@model WebClinicSystem.Web.Pages.Home.DashboardModel
@{
    ViewData["Title"] = "Painel";
}

<div class="mb-4">
    <h1>Painel</h1>
    <p class="text-muted">Olá! Bem-vindo(a) de volta. Aqui está um resumo do seu dia.</p>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card stat-card position-relative" data-href="/Agenda">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">Consultas Agendadas Hoje</h6>
                    <h2 class="fw-bold mb-0">0</h2>
                </div>
                <div class="stat-icon icon-blue">
                    <i class="bi bi-calendar-check"></i>
                </div>
            </div>
            <div class="card-footer bg-white border-0 text-end">
                <a class="btn btn-sm btn-outline-primary" href="/Agenda">Abrir Agenda</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card position-relative" data-href="/Pacientes">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">Pacientes Atendidos</h6>
                    <h2 class="fw-bold mb-0">0</h2>
                </div>
                <div class="stat-icon icon-green">
                    <i class="bi bi-person-check"></i>
                </div>
            </div>
            <div class="card-footer bg-white border-0 text-end">
                <a class="btn btn-sm btn-outline-primary" href="/Pacientes">Ver Pacientes</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card position-relative" data-href="/Profissionais">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted mb-1">Próxima Consulta</h6>
                    <h2 class="fw-bold mb-0">-</h2>
                </div>
                 <div class="stat-icon icon-green">
                    <i class="bi bi-clock"></i>
                </div>
            </div>
            <div class="card-footer bg-white border-0 text-end">
                <a class="btn btn-sm btn-outline-primary" href="/Agenda">Ver Agenda</a>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-start">
        <div>
            <h5>Consultas de Hoje</h5>
            <p class="text-muted small">visite sua agenda diária</p>
        </div>
        <div>
            <a class="btn btn-sm btn-outline-secondary" href="/Agenda">Abrir Agenda</a>
        </div>
    </div>
    <div class="card-body text-center text-muted" data-href="/Agenda" style="cursor:pointer;">
        <i class="bi bi-calendar-x" style="font-size: 2rem;"></i>
        <p class="mt-2 mb-0">Nenhuma consulta agendada</p>
        <small>Você está com a agenda livre para hoje.</small>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Torna os cards clicáveis: se o usuário clicar em qualquer lugar do card, navega para o destino
        document.querySelectorAll('.card.position-relative[data-href]').forEach(function(card) {
            card.style.cursor = 'pointer';
            card.addEventListener('click', function (e) {
                // evita disparar quando clicar em um link interno (botão)
                if (e.target.closest('a') || e.target.closest('button')) return;
                var href = card.getAttribute('data-href');
                if (href) window.location.href = href;
            });
        });

        // Card principal "Consultas de Hoje"
        var mainCardBody = document.querySelector('.card-body[data-href]');
        if (mainCardBody) {
            mainCardBody.addEventListener('click', function (e) {
                if (e.target.closest('a') || e.target.closest('button')) return;
                var href = mainCardBody.getAttribute('data-href');
                if (href) window.location.href = href;
            });
        }
    });
</script>
}